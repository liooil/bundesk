{
  "name": "bun-desktop-app",
  "version": "0.1.0",
  "description": "Build Bun-powered local web apps as desktop executables with reproducible Windows metadata and console behavior.",
  "type": "module",
  "bin": {
    "bun-desktop-app": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "pack:check": "bun pm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liooil/bun-desktop-app.git"
  },
  "bugs": {
    "url": "https://github.com/liooil/bun-desktop-app/issues"
  },
  "homepage": "https://github.com/liooil/bun-desktop-app#readme",
  "keywords": [
    "bun",
    "desktop",
    "executable",
    "windows",
    "bundler"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.12",
    "@zip.js/zip.js": "^2.8.26",
    "resedit": "^3.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "~5.9.3"
  }
}
